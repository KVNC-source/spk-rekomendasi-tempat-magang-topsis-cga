# Copy this file to .env and fill in the values. .env is ignored by git; this file
# only lists the variable names (never put real values or passwords here).

# PostgreSQL connection string
DATABASE_URL=

# Port the API listens on (the client expects 5000 by default)
PORT=

# Origin of the web client, for example http://localhost:5173. The API accepts
# browser requests only from here and lets it send the session cookie.
CLIENT_ORIGIN=

# How long a login session lasts, in hours (8 when left empty)
SESSION_HOURS=

# Successful self-registrations allowed per IP per hour (5 when left empty). Students on
# one network share an IP: raise this before a group session.
DAFTAR_MAKS_PER_JAM=

# Initial passwords of the two CONTOH accounts created by `npm run seed`
# (contoh-web-manado@example.invalid and contoh-admin@example.invalid).
# Required: the seed stops when one is empty. Use at least 8 characters.
SEED_PASSWORD_MAHASISWA=
SEED_PASSWORD_ADMIN=
