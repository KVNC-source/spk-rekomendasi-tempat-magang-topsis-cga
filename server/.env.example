# Copy this file to .env and fill in the values. .env is ignored by git; this file
# only lists the variable names (never put real values or passwords here).
#
# On a laptop only DATABASE_URL, PORT, CLIENT_ORIGIN and the SEED_* passwords are needed.
# The variables marked [produksi] are for the hosted site (see docs/DEPLOY.md); leave them
# empty on a laptop.

# --- Database -------------------------------------------------------------------------------

# PostgreSQL connection string.
# Laptop:      postgresql://USER:PASSWORD@localhost:5432/NAMA_DATABASE
# [produksi]   the Neon DIRECT connection string (host WITHOUT "-pooler"), ending in
#              ?sslmode=require   (remove "&channel_binding=require" if it is there)
DATABASE_URL=

# --- Server ---------------------------------------------------------------------------------

# Port the API listens on (the client expects 5000 by default). On Render this is set by the
# platform: leave it empty there.
PORT=

# [produksi] "production" makes the server also serve the built client (client/dist) at the same
# address as the API, send the security headers and set the session cookie as Secure.
NODE_ENV=

# Origin of the web client: the address people type in the browser, with no path and no trailing
# slash. The API accepts browser requests only from here and lets it send the session cookie.
# Laptop:      http://localhost:5173
# [produksi]   https://NAMA-SITUS.onrender.com   (the site's own address, https)
CLIENT_ORIGIN=

# [produksi] How many proxies stand in front of the server: 1 on Render. Leave empty on a laptop.
# It decides which IP the server sees (the login and registration limits count by IP). Too low:
# everyone shares one limit. Too high or "true": a visitor can fake the IP and walk around the limits.
TRUST_PROXY=

# [produksi, optional] Where the built client is. Default: ../client/dist next to the server folder.
CLIENT_DIST=

# --- Sessions and limits --------------------------------------------------------------------

# How long a login session lasts, in hours (8 when left empty)
SESSION_HOURS=

# Successful self-registrations allowed per IP per hour (5 when left empty). Students on
# one network share an IP: raise this before a group session.
DAFTAR_MAKS_PER_JAM=

# --- Seed (npm run seed) --------------------------------------------------------------------

# Initial password of the administrator account, and of the CONTOH mahasiswa account (laptop).
# Required: the seed stops when a needed one is empty. 8 characters or more on a laptop;
# in production the administrator password needs 12 characters or more.
SEED_PASSWORD_ADMIN=
SEED_PASSWORD_MAHASISWA=

# [produksi, optional] The administrator's login email. Empty = contoh-admin@example.invalid, which
# is written in the repository: use another address in production.
SEED_ADMIN_EMAIL=

# [produksi, optional] "ya" also creates the CONTOH mahasiswa account (contoh-web-manado@example.invalid)
# with its sample profile, for a demo. Empty = not created in production. Needs
# SEED_PASSWORD_MAHASISWA with 12 characters or more. On a laptop the account is always created.
SEED_AKUN_CONTOH=
